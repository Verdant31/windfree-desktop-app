<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Configurações do Brisa" Width="380" SizeToContent="Height" WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
 Background="Transparent" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Grid Background="{DynamicResource WindowFill}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="24,16,16,24">
   <Grid x:Name="DialogHeader" Background="Transparent" Margin="0,0,0,8">
    <TextBlock Text="Conexão do aparelho" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="Dismiss" Style="{DynamicResource SubtleButton}" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" AutomationProperties.Name="Fechar configurações" ToolTip="Fechar"><TextBlock Text="&#xE8BB;" Style="{DynamicResource Glyph}" FontSize="12"/></Button>
   </Grid>
   <StackPanel Margin="0,0,8,0">
    <TextBlock x:Name="IdentityHint" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="20"/>
    <TextBlock Text="Nome do cômodo" Margin="0,20,0,8"/>
    <TextBox x:Name="NameField" MaxLength="28" AutomationProperties.Name="Nome do cômodo"/>
    <TextBlock Text="IP na rede Wi-Fi" Margin="0,16,0,8"/>
    <TextBox x:Name="IpField" MaxLength="15" AutomationProperties.Name="IP na rede Wi-Fi"/>
    <TextBlock Text="Se o roteador mudou o IP, atualize aqui. O Brisa verifica a identidade do aparelho antes de conectar." Margin="0,8,0,0" FontSize="12" LineHeight="16" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
    <TextBlock x:Name="Validation" Margin="0,8,0,0" FontSize="12" LineHeight="16" Foreground="{DynamicResource Critical}" TextWrapping="Wrap"/>
   </StackPanel>
  </StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource FooterFill}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="Save" Style="{DynamicResource AccentButton}" Content="Salvar e reconectar" IsDefault="True"/>
    <Button x:Name="Cancel" Grid.Column="2" Style="{DynamicResource StandardButton}" Content="Cancelar" IsCancel="True"/>
   </Grid>
  </Border>
 </Grid>
</Window>
