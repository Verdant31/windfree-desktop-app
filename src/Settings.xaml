<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Configurações do Brisa" Width="420" Height="470" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="False" Background="#0D0E0C" Foreground="#E8E9E1" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <Border CornerRadius="18" BorderBrush="#494B44" BorderThickness="1" Padding="25" RenderOptions.ClearTypeHint="Enabled">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="52"/><RowDefinition Height="78"/><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
   <Grid x:Name="DialogHeader"><TextBlock Text="Conexão do aparelho" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="Dismiss" Width="32" Height="32" HorizontalAlignment="Right" Background="Transparent" AutomationProperties.Name="Fechar configurações"><Path Data="M 1 1 L 13 13 M 13 1 L 1 13" Stroke="#CBCDC1" StrokeThickness="1.5" Width="14" Height="14"/></Button></Grid>
   <TextBlock x:Name="IdentityHint" Grid.Row="1" Text="" TextWrapping="Wrap" Foreground="#B1B5A6" LineHeight="19" VerticalAlignment="Center"/>
   <StackPanel Grid.Row="2"><TextBlock Text="Nome do cômodo" Foreground="#CBCDC1" Margin="0,0,0,6"/><TextBox x:Name="NameField" MaxLength="28" AutomationProperties.Name="Nome do cômodo"/></StackPanel>
   <StackPanel Grid.Row="3"><TextBlock Text="IP na rede Wi-Fi" Foreground="#CBCDC1" Margin="0,0,0,6"/><TextBox x:Name="IpField" MaxLength="15" AutomationProperties.Name="IP na rede Wi-Fi"/></StackPanel>
   <StackPanel Grid.Row="4" Margin="0,4,0,12"><TextBlock Text="Se o roteador mudou o IP, atualize aqui. O Brisa verifica a identidade do aparelho antes de conectar." Foreground="#B1B5A6" TextWrapping="Wrap" LineHeight="19"/><TextBlock x:Name="Validation" Text="" Foreground="#F4B8A3" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="19"/></StackPanel>
   <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Cancel" Content="Cancelar" IsCancel="True"/><Button x:Name="Save" Grid.Column="2" Content="Salvar e reconectar" Tag="Primary" Background="#B9B6A4" Foreground="#191B16" FontWeight="SemiBold" IsDefault="True"/></Grid>
  </Grid>
 </Border>
</Window>
