<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Brisa — Samsung" Width="540" Height="570" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="False"
 Background="#0D0E0C" Foreground="#E8E9E1" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1A1B17"/><Setter Property="Foreground" Value="#E8E9E1"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="13" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#252620"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B9B6A4"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.48"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Primary"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="#CBC8B5"/></MultiTrigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Primary"/><Condition Property="IsKeyboardFocused" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="BorderBrush" Value="#191B16"/></MultiTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Circle" Background="{TemplateBinding Background}" CornerRadius="24" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#282922"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="#B9B6A4"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.48"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#E8E9E1"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="Tile" Background="#1A1B17" CornerRadius="12" BorderBrush="Transparent" BorderThickness="1"><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#A8AA9D" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,21,13,0"/></Border>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#252620"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"/>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="14,0,6,10" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <Border Background="#20211C" BorderBrush="#4B4D42" BorderThickness="1" CornerRadius="10" MinWidth="150" Padding="4"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="#B9B6A4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#E8E9E1"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#35362D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#2D2E26"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RoomSelector" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Selector" Background="#1A1B17" CornerRadius="9" BorderBrush="#33352C" BorderThickness="1"><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#B1B5A6" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selector" Property="Background" Value="#252620"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" IsHitTestVisible="False"/>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,35,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="#20211C" BorderBrush="#4B4D42" BorderThickness="1" CornerRadius="10" MinWidth="210" Padding="4"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border>
     </Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="#B9B6A4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Height" Value="44"/>
   <Setter Property="Background" Value="#1A1B17"/><Setter Property="Foreground" Value="#E8E9E1"/><Setter Property="CaretBrush" Value="#D0CFBF"/><Setter Property="SelectionBrush" Value="#696757"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#45483C"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#B9B6A4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="Transparent" Margin="1,12">
     <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource TrackButton}" Background="Transparent"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ScrollGrip" Width="5" Background="#45483E" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollGrip" Property="Background" Value="#858A78"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource TrackButton}" Background="Transparent"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid>
     <Border Background="#10110F" CornerRadius="16"/>
     <Grid x:Name="TemperatureFillClip" Margin="1" IsHitTestVisible="False">
      <Border x:Name="TemperatureFill" HorizontalAlignment="Left" Width="0" CornerRadius="15">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#36372C" Offset="0"/><GradientStop Color="#696757" Offset="1"/></LinearGradientBrush></Border.Background>
      </Border>
     </Grid>
      <Track x:Name="PART_Track" Margin="1" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
       <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackButton}" Background="Transparent"/></Track.DecreaseRepeatButton>
       <Track.Thumb><Thumb Width="30" Height="44"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" CornerRadius="10" Background="#D0CFBF" BorderBrush="#B4B3A4" BorderThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#E4E3D4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackButton}" Background="Transparent"/></Track.IncreaseRepeatButton>
      </Track>
     <Border x:Name="SliderChrome" BorderBrush="#25261F" BorderThickness="1" CornerRadius="16" IsHitTestVisible="False"/>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SliderChrome" Property="BorderBrush" Value="#B9B6A4"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="PanelRoot" RenderOptions.ClearTypeHint="Enabled">
  <Path x:Name="PanelOutline" Data="M 30 14 H 249 C 258 14 259 1 270 1 C 281 1 282 14 291 14 H 510 Q 539 14 539 44 V 539 Q 539 569 509 569 H 31 Q 1 569 1 539 V 44 Q 1 14 30 14 Z" Fill="#0D0E0C" Stroke="#494B44" StrokeThickness="1.2"/>
  <ScrollViewer x:Name="MainScroll" Margin="2,15,2,2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="24,20,24,12" MinHeight="518">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="156"/><RowDefinition Height="74"/><RowDefinition Height="82"/><RowDefinition Height="100"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="Header">
     <Grid Margin="0,0,66,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="Rooms" Style="{StaticResource RoomSelector}" Height="40" VerticalAlignment="Center" AutomationProperties.Name="Selecionar cômodo" ToolTip="Selecionar o ar-condicionado"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,4,0">
       <Path Data="M 6 2 A 3 3 0 0 1 12 2 V 15 A 6 6 0 1 1 6 15 Z M 9 5 V 19" Stroke="#A4A28F" StrokeThickness="1.6" Width="12" Height="19" Stretch="Uniform" Margin="0,0,7,0"/>
       <TextBlock x:Name="Room" Text="—" FontSize="15" FontWeight="SemiBold" Foreground="#CBCDC1" VerticalAlignment="Center" ToolTip="Temperatura ambiente"/>
      </StackPanel>
     </Grid>
     <Button x:Name="Power" HorizontalAlignment="Right" Style="{StaticResource RoundButton}" IsEnabled="False" ToolTip="Ligar ou desligar" AutomationProperties.Name="Ligar ou desligar">
      <Path x:Name="PowerDrawing" Data="M 12 1 V 13 M 5 5 A 12 12 0 1 0 19 5" Stroke="#A4A28F" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="28" Height="30" Stretch="Uniform"/>
     </Button>
    </Grid>
    <Grid Grid.Row="1">
     <Canvas Width="200" Height="142" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
      <Path x:Name="AirDrawing" Data="M 24 66 Q 20 96 4 116 M 43 68 Q 41 104 27 130 M 61 70 Q 64 107 55 132 M 80 71 Q 86 110 80 138 M 99 72 Q 109 111 107 139 M 118 73 Q 130 110 136 136 M 138 73 Q 154 104 165 131 M 156 72 Q 175 99 188 121" StrokeThickness="5" Opacity="0">
       <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#82918D" Offset="0"/><GradientStop Color="#768582" Offset="0.55"/><GradientStop Color="#00768582" Offset="1"/></LinearGradientBrush></Path.Stroke><Path.Effect><BlurEffect Radius="6"/></Path.Effect>
      </Path>
      <Image x:Name="Appliance" Width="176" Height="78" Canvas.Left="12" Canvas.Top="0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
     </Canvas>
     <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#20201B" BorderBrush="#605949" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12" VerticalAlignment="Center"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#E2C5AC" FontSize="13" LineHeight="19"/></Border>
    </Grid>
    <Grid Grid.Row="2">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,-6,0,0"><TextBlock x:Name="Setpoint" Text="—" FontSize="60" FontWeight="SemiBold"/><TextBlock x:Name="Unit" Text="°C" FontSize="27" FontWeight="SemiBold" Foreground="#AEB1A4" VerticalAlignment="Bottom" Margin="2,0,0,12"/></StackPanel>
     <Button x:Name="WindFree" Width="216" Height="52" HorizontalAlignment="Right" IsEnabled="False" AutomationProperties.Name="Ativar ou desativar WindFree" ToolTip="WindFree: refrigeração sem vento direto">
      <Grid Width="188"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
       <Path Data="M 2 5 Q 12 4 21 11 M 1 12 Q 10 9 19 17 M 3 20 Q 13 18 22 22" Stroke="#A4A795" StrokeThickness="2" StrokeStartLineCap="Round" Width="24" Height="25"/>
       <TextBlock Text="WindFree" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <Border x:Name="WindTrack" Grid.Column="2" Width="58" Height="26" Background="#2B2D25" CornerRadius="13"><Border x:Name="WindThumb" Width="36" Height="22" Background="#A2A699" CornerRadius="11" HorizontalAlignment="Left" Margin="2,0"/></Border>
      </Grid>
     </Button>
    </Grid>
    <Grid Grid.Row="3" Margin="0,4,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="28"/></Grid.RowDefinitions>
     <Button x:Name="Minus" Style="{StaticResource RoundButton}" IsEnabled="False" AutomationProperties.Name="Diminuir temperatura" ToolTip="Diminuir temperatura"><Path Data="M 0 7 H 16" Stroke="#C7CBBE" StrokeThickness="2.2" Width="16" Height="16"/></Button>
     <Slider x:Name="Temperature" Grid.Column="1" IsEnabled="False" Minimum="16" Maximum="30" Value="16" TickFrequency="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="12,0" Height="50" AutomationProperties.Name="Temperatura definida"/>
     <Button x:Name="Plus" Grid.Column="2" Style="{StaticResource RoundButton}" IsEnabled="False" AutomationProperties.Name="Aumentar temperatura" ToolTip="Aumentar temperatura"><Path Data="M 0 8 H 16 M 8 0 V 16" Stroke="#C7CBBE" StrokeThickness="2.2" Width="16" Height="16"/></Button>
     <TextBlock x:Name="Minimum" Grid.Row="1" Grid.Column="1" Text="—" Margin="12,7,0,0" FontSize="12" Foreground="#A4A795"/><TextBlock x:Name="Maximum" Grid.Row="1" Grid.Column="1" Text="—" HorizontalAlignment="Right" Margin="0,7,12,0" FontSize="12" Foreground="#A4A795"/>
    </Grid>
    <Grid Grid.Row="4" Margin="0,8,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><ComboBox x:Name="Modes" IsEnabled="False" AutomationProperties.Name="Modo de operação"/><Path Data="M 14 1 V 27 M 3 7 L 25 21 M 3 21 L 25 7 M 9 3 L 14 7 L 19 3 M 9 25 L 14 21 L 19 25 M 2 12 L 8 12 L 8 6 M 26 16 L 20 16 L 20 22" Stroke="#A4A795" StrokeThickness="1.3" Width="27" Height="27" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0" IsHitTestVisible="False"/><TextBlock Text="Modo" Foreground="#A4A795" FontSize="13" Margin="14,0,0,31" VerticalAlignment="Bottom" IsHitTestVisible="False"/></Grid>
     <Grid Grid.Column="2"><ComboBox x:Name="Fans" IsEnabled="False" AutomationProperties.Name="Velocidade de ventilação"/><Path Data="M 14 14 C -2 13 0 -5 11 3 C 15 6 15 10 14 14 C 15 -2 33 0 25 11 C 22 15 18 15 14 14 C 30 15 28 33 17 25 C 13 22 13 18 14 14 C 13 30 -5 28 3 17 C 6 13 10 13 14 14 Z" Stroke="#A4A795" StrokeThickness="1.2" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0" IsHitTestVisible="False"/><TextBlock Text="Ventilação" Foreground="#A4A795" FontSize="13" Margin="14,0,0,31" VerticalAlignment="Bottom" IsHitTestVisible="False"/></Grid>
     <Button x:Name="Sleep" Grid.Column="4" IsEnabled="False" AutomationProperties.Name="Ativar ou desativar modo sono">
      <Grid Width="100" Height="90"><Path Data="M 16 2 A 14 14 0 1 0 28 21 A 14 14 0 0 1 16 2 Z" Stroke="#A4A795" StrokeThickness="1.4" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,10,0,0"/><Ellipse x:Name="SleepDot" Width="6" Height="6" Fill="#4F5246" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,9,0"/><TextBlock Text="Sono" Foreground="#A4A795" FontSize="13" Margin="8,0,0,29" VerticalAlignment="Bottom"/><TextBlock x:Name="SleepValue" Text="—" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,8" VerticalAlignment="Bottom"/></Grid>
     </Button>
     <Grid Grid.Column="6"><ComboBox x:Name="Airflow" IsEnabled="False" AutomationProperties.Name="Direção do fluxo de ar"/><Path Data="M 1 8 H 17 C 26 8 25 -1 18 1 M 1 15 H 24 C 32 15 32 6 26 6 M 1 22 H 14 C 22 22 22 31 15 29" Stroke="#A4A795" StrokeThickness="1.4" Width="29" Height="29" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,11,0,0" IsHitTestVisible="False"/><TextBlock Text="Fluxo de ar" Foreground="#A4A795" FontSize="13" Margin="14,0,0,31" VerticalAlignment="Bottom" IsHitTestVisible="False"/></Grid>
    </Grid>
    <Grid Grid.Row="5" Margin="0,12,0,0">
     <Button x:Name="Refresh" Background="Transparent" HorizontalAlignment="Left" ToolTip="Atualizar estado" AutomationProperties.Name="Atualizar estado" Padding="0,6">
      <StackPanel Orientation="Horizontal"><Path x:Name="ConnectionDrawing" Data="M 7 1 L 13 3 V 8 Q 12 12 7 14 Q 2 12 1 8 V 3 Z M 4 7 L 6 9 L 10 5" Stroke="#A4A795" StrokeThickness="1.3" Width="14" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="Conectando…" Foreground="#B1B5A6" FontSize="13" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <Button x:Name="Connect" Background="Transparent" Width="36" Height="34" HorizontalAlignment="Right" ToolTip="Configurar conexão" AutomationProperties.Name="Configurar conexão"><Path Data="M 1 4 H 22 M 1 12 H 22 M 1 20 H 22 M 7 1 V 7 M 17 9 V 15 M 10 17 V 23" Stroke="#A4A795" StrokeThickness="1.4" Width="23" Height="24"/></Button>
    </Grid>
   </Grid>
  </ScrollViewer>
 </Grid>
</Window>
