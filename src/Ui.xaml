<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Brisa — Samsung" Width="380" Height="511" WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
 Background="Transparent" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <Storyboard x:Key="HoverIn"><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083"/></Storyboard>
  <Storyboard x:Key="HoverOut"><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.167"/></Storyboard>
  <Style x:Key="Glyph" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="TileGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
   <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="12,12,0,0"/>
  </Style>
  <Style x:Key="TileLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
   <Setter Property="VerticalAlignment" Value="Bottom"/><Setter Property="Margin" Value="12,0,12,31"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="FocusRing">
   <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border Margin="-3" BorderBrush="{DynamicResource FocusOuter}" BorderThickness="2" CornerRadius="7"><Border BorderBrush="{DynamicResource FocusInner}" BorderThickness="1" CornerRadius="5"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FocusRingRound">
   <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border Margin="-3" BorderBrush="{DynamicResource FocusOuter}" BorderThickness="2" CornerRadius="99"><Border BorderBrush="{DynamicResource FocusInner}" BorderThickness="1" CornerRadius="99"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="SubtleButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8,6"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Root">
     <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
     <Border x:Name="Hover" Background="{DynamicResource SubtleHover}" CornerRadius="4" Opacity="0"/>
     <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Content" Property="Opacity" Value="0.79"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="StandardButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource ControlFill}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
   <Setter Property="Padding" Value="12,5,12,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Root">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/>
     <Border x:Name="Hover" Background="{DynamicResource SubtleHover}" CornerRadius="4" Opacity="0"/>
     <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Content" Property="Opacity" Value="0.79"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
   <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/><Setter Property="Background" Value="{DynamicResource AccentFill}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Root">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/>
     <Border x:Name="Hover" Background="{DynamicResource AccentHover}" CornerRadius="4" Opacity="0"/>
     <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Content" Property="Opacity" Value="0.79"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CircleButton" TargetType="Button">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Root">
     <Ellipse Fill="{DynamicResource ControlFill}" Stroke="{DynamicResource ControlBorder}" StrokeThickness="1"/>
     <Ellipse x:Name="Hover" Fill="{DynamicResource SubtleHover}" Opacity="0"/>
     <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Content" Property="Opacity" Value="0.79"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PowerToggle" TargetType="ToggleButton">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Grid x:Name="Root">
     <Ellipse x:Name="Fill" Fill="{DynamicResource ControlFill}" Stroke="{DynamicResource ControlBorder}" StrokeThickness="1"/>
     <Ellipse x:Name="Hover" Fill="{DynamicResource SubtleHover}" Opacity="0"/>
     <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Fill" Property="Fill" Value="{DynamicResource AccentFill}"/><Setter TargetName="Fill" Property="Stroke" Value="{DynamicResource AccentBorder}"/>
      <Setter TargetName="Hover" Property="Fill" Value="{DynamicResource AccentHover}"/><Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Content" Property="Opacity" Value="0.79"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SwitchTile" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Grid x:Name="Root">
     <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" CornerRadius="6"/>
     <Border x:Name="Hover" Background="{DynamicResource SubtleHover}" CornerRadius="6" Opacity="0"/>
     <Grid Margin="12,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentPresenter x:Name="Content" VerticalAlignment="Center"/>
      <Grid Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center">
       <Border x:Name="Track" CornerRadius="10" Background="Transparent" BorderBrush="{DynamicResource ControlStrokeStrong}" BorderThickness="1"/>
       <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource TextSecondary}" HorizontalAlignment="Left" Margin="4,0,0,0">
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
       </Ellipse>
      </Grid>
     </Grid>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFill}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFill}"/>
      <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccent}"/>
      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.167"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.167"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="Knob" Property="Width" Value="14"/><Setter TargetName="Knob" Property="Height" Value="14"/><Setter TargetName="Knob" Property="Margin" Value="3,0,0,0"/>
      <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Content" Property="Opacity" Value="0.79"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Padding" Value="12,0"/><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Grid Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
     <Border x:Name="Row" CornerRadius="4" Background="Transparent"/>
     <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource AccentFill}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleHover}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleHover}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TileCombo" TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid x:Name="Root">
     <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Grid Background="Transparent">
        <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" CornerRadius="6"/>
        <Border x:Name="Hover" Background="{DynamicResource SubtleHover}" CornerRadius="6" Opacity="0"/>
        <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,12,0"/>
       </Grid>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding Tag}" IsHitTestVisible="False"/>
     <TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0}}" Margin="12,0,12,11" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="2" HorizontalOffset="-8" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
      <Grid Margin="8,0,8,16" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
       <Border Background="{DynamicResource FlyoutFill}" CornerRadius="8"><Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.3" Color="Black"/></Border.Effect></Border>
       <Border BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1" CornerRadius="8" Padding="4,3">
        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
       </Border>
      </Grid>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RoomCombo" TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid x:Name="Root">
     <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Grid Background="Transparent"><Border x:Name="Hover" Background="{DynamicResource SubtleHover}" CornerRadius="4" Opacity="0"/></Grid>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <StackPanel Orientation="Horizontal" Margin="8,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False">
      <TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0}}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="8,2,0,0"/>
     </StackPanel>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="2" HorizontalOffset="-8" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
      <Grid Margin="8,0,8,16" MinWidth="200">
       <Border Background="{DynamicResource FlyoutFill}" CornerRadius="8"><Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.3" Color="Black"/></Border.Effect></Border>
       <Border BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1" CornerRadius="8" Padding="4,3">
        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
       </Border>
      </Grid>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentFill}"/>
   <Setter Property="Background" Value="{DynamicResource ControlFill}"/><Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,5,6,6"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
     <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="Background" Value="{DynamicResource SubtleHover}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True">
      <Setter TargetName="Field" Property="Background" Value="{DynamicResource InputActive}"/><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource TextBoxBorderFocused}"/>
      <Setter TargetName="Field" Property="BorderThickness" Value="1,1,1,2"/><Setter Property="Padding" Value="10,5,6,5"/>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="TrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TrackFill" TargetType="RepeatButton" BasedOn="{StaticResource TrackButton}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
   <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{DynamicResource AccentFill}" Margin="10,0,-10,0" VerticalAlignment="Center"/></Grid>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider">
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid x:Name="Root" Background="Transparent">
     <Border Height="4" CornerRadius="2" Background="{DynamicResource ControlStrokeStrong}" Margin="10,0" VerticalAlignment="Center"/>
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackFill}"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="20" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb">
       <Grid>
        <Ellipse Fill="{DynamicResource SolidControl}" Stroke="{DynamicResource ControlBorder}" StrokeThickness="1"/>
        <Ellipse x:Name="Inner" Width="12" Height="12" Fill="{DynamicResource AccentFill}"/>
       </Grid>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Inner" Property="Width" Value="14"/><Setter TargetName="Inner" Property="Height" Value="14"/></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Inner" Property="Width" Value="10"/><Setter TargetName="Inner" Property="Height" Value="10"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackButton}"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="12"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="Transparent" Margin="0,4">
     <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource TrackButton}"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Width="3" Background="{DynamicResource ScrollThumb}" CornerRadius="1.5" HorizontalAlignment="Center"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Width" Value="6"/><Setter TargetName="Grip" Property="CornerRadius" Value="3"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Width" Value="6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource TrackButton}"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="HasDropShadow" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
    <Grid Margin="6,2,6,10" MaxWidth="320">
     <Border Background="{DynamicResource FlyoutFill}" CornerRadius="4"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.22" Color="Black"/></Border.Effect></Border>
     <Border BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1" CornerRadius="4" Padding="8,5,8,7">
      <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
     </Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Grid x:Name="PanelRoot" Background="{DynamicResource WindowFill}">
  <Grid x:Name="PanelContent">
   <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="16,12,16,16">
     <Grid x:Name="Header" Height="36" Background="Transparent">
      <ComboBox x:Name="Rooms" Style="{StaticResource RoomCombo}" Height="32" HorizontalAlignment="Left" Margin="-8,0,0,0" AutomationProperties.Name="Selecionar cômodo" ToolTip="Selecionar o ar-condicionado"/>
      <ToggleButton x:Name="Power" Style="{StaticResource PowerToggle}" HorizontalAlignment="Right" IsEnabled="False" ToolTip="Ligar ou desligar" AutomationProperties.Name="Ligar ou desligar"><TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}"/></ToggleButton>
     </Grid>

     <Grid Height="108" Margin="0,4,0,0">
      <Canvas Width="200" Height="108" HorizontalAlignment="Center" IsHitTestVisible="False">
       <Canvas.Style><Style TargetType="Canvas"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=ErrorPanel}" Value="Visible"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
       <Path x:Name="AirDrawing" Data="M 40 52 Q 33 80 13.9 104 M 59.3 52 Q 54.7 80 41.9 104 M 78.7 52 Q 76.3 80 70 104 M 98 52 Q 98 80 98 104 M 117.3 52 Q 119.7 80 126 104 M 136.7 52 Q 141.3 80 154.1 104 M 156 52 Q 163 80 182.1 104" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0">
        <Path.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.15"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Path.OpacityMask>
       </Path>
       <Image x:Name="Appliance" Width="168" Height="56" Canvas.Left="16" Canvas.Top="0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Canvas>
      <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="{DynamicResource CriticalBackground}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" CornerRadius="6" Padding="12,10,14,11" VerticalAlignment="Center">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Top" Margin="0,1,12,0"><TextBlock Text="&#xF136;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Critical}"/><TextBlock Text="&#xF13D;" Style="{StaticResource Glyph}" Foreground="{DynamicResource OnStatus}"/></Grid>
        <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" LineHeight="18"/>
       </Grid>
      </Border>
     </Grid>

     <Grid Margin="0,2,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="Minus" Style="{StaticResource CircleButton}" IsEnabled="False" AutomationProperties.Name="Diminuir temperatura" ToolTip="Diminuir temperatura"><TextBlock Text="&#xE738;" Style="{StaticResource Glyph}" FontSize="14"/></Button>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center">
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock x:Name="Setpoint" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="52" FontWeight="SemiBold" LineHeight="60" LineStackingStrategy="BlockLineHeight"/>
        <TextBlock x:Name="Unit" Text="" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="3,10,0,0"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="Temperatura ambiente">
        <TextBlock Text="&#xE9CA;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,1,4,0"/>
        <TextBlock Text="Ambiente " FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
        <TextBlock x:Name="Room" Text="—" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
       </StackPanel>
      </StackPanel>
      <Button x:Name="Plus" Grid.Column="2" Style="{StaticResource CircleButton}" IsEnabled="False" AutomationProperties.Name="Aumentar temperatura" ToolTip="Aumentar temperatura"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14"/></Button>
     </Grid>

     <Slider x:Name="Temperature" IsEnabled="False" Minimum="16" Maximum="30" Value="16" TickFrequency="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Height="32" Margin="0,10,0,0" AutomationProperties.Name="Temperatura definida"/>
     <Grid Margin="4,0,4,0">
      <TextBlock x:Name="Minimum" Text="—" FontSize="12" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Left"/>
      <TextBlock x:Name="Maximum" Text="—" FontSize="12" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Right"/>
     </Grid>

     <Grid Height="80" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ComboBox x:Name="Modes" Style="{StaticResource TileCombo}" IsEnabled="False" AutomationProperties.Name="Modo de operação">
       <ComboBox.Tag><Grid>
        <Path x:Name="ModeSnow" Data="M 8 1 L 8 15 M 14.06 4.5 L 1.94 11.5 M 14.06 11.5 L 1.94 4.5 M 8 3.6 L 9.84 1.76 M 8 3.6 L 6.16 1.76 M 11.81 5.8 L 14.32 6.47 M 11.81 5.8 L 12.48 3.29 M 11.81 10.2 L 12.48 12.71 M 11.81 10.2 L 14.32 9.53 M 8 12.4 L 6.16 14.24 M 8 12.4 L 9.84 14.24 M 4.19 10.2 L 1.68 9.53 M 4.19 10.2 L 3.52 12.71 M 4.19 5.8 L 3.52 3.29 M 4.19 5.8 L 1.68 6.47" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0"/>
        <TextBlock x:Name="ModeIcon" Style="{StaticResource TileGlyph}"/>
        <TextBlock Text="Modo" Style="{StaticResource TileLabel}"/>
       </Grid></ComboBox.Tag>
      </ComboBox>
      <ComboBox x:Name="Fans" Grid.Column="2" Style="{StaticResource TileCombo}" IsEnabled="False" AutomationProperties.Name="Velocidade de ventilação">
       <ComboBox.Tag><Grid><TextBlock x:Name="FanIcon" Text="&#xEC49;" Style="{StaticResource TileGlyph}"/><TextBlock Text="Ventilação" Style="{StaticResource TileLabel}"/></Grid></ComboBox.Tag>
      </ComboBox>
      <ComboBox x:Name="Airflow" Grid.Column="4" Style="{StaticResource TileCombo}" IsEnabled="False" AutomationProperties.Name="Direção do fluxo de ar">
       <ComboBox.Tag><Grid><TextBlock x:Name="AirflowIcon" Text="&#xEDA8;" Style="{StaticResource TileGlyph}"/><TextBlock Text="Fluxo de ar" Style="{StaticResource TileLabel}"/></Grid></ComboBox.Tag>
      </ComboBox>
     </Grid>

     <Grid Height="48" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ToggleButton x:Name="WindFree" Style="{StaticResource SwitchTile}" IsEnabled="False" AutomationProperties.Name="WindFree" ToolTip="WindFree: refrigeração sem vento direto">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE75F;" Style="{StaticResource Glyph}" Margin="0,0,10,0"/><TextBlock Text="WindFree" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="Sleep" Grid.Column="2" Style="{StaticResource SwitchTile}" IsEnabled="False" AutomationProperties.Name="Modo sono" ToolTip="Modo sono">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" Margin="0,0,10,0"/><TextBlock Text="Sono" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      </ToggleButton>
     </Grid>
    </StackPanel>
   </ScrollViewer>

   <Border Grid.Row="1" Background="{DynamicResource FooterFill}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="8">
    <Grid>
     <Button x:Name="Refresh" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Height="32" ToolTip="Atualizar estado" AutomationProperties.Name="Atualizar estado">
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Caution}" Margin="0,1,8,0" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="Conectando…" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <Button x:Name="Connect" Style="{StaticResource SubtleButton}" Width="36" Height="32" Padding="0" HorizontalAlignment="Right" ToolTip="Configurar conexão" AutomationProperties.Name="Configurar conexão"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}"/></Button>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
